{
  "name": "@thewituch/opencode-git-sidebar",
  "version": "0.1.0",
  "description": "Configurable Git status and recent commits in the OpenCode TUI sidebar",
  "license": "GPL-3.0-only",
  "keywords": ["opencode", "opencode-plugin", "git", "git-status", "sidebar", "tui"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theWituch/opencode-git-sidebar.git"
  },
  "homepage": "https://github.com/theWituch/opencode-git-sidebar#readme",
  "bugs": "https://github.com/theWituch/opencode-git-sidebar/issues",
  "type": "module",
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": ["src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
