    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.4.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0 <1",
    "@opentui/solid": ">=0.8.0 <1",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode/theme": "2.4.1",
    "@opentui/core": "0.9.4",
    "@opentui/solid": "0.9.4",
    "@types/node": "^24.19.2",
    "solid-js": "^1.9.12",
    "typescript": "~5.9.3"
  }
}
